# HPI AISC site flags. hpi/sml.env sets SML_SITE_ARGS to this file, so sml prepends it to
# every `sml advanced`; recipes only carry what differs per model. The env toml comes from
# SML_ENVIRONMENT (also set in hpi/sml.env, next to this file).
--container-spec pyxis
--enroot-data-path '/sc/projects/sci-aisc/aisc-share/enroot-data/$USER'
--no-exclusive
--sbatch-arg=--exclude=ga03
--framework-port auto
--disable-metrics
--disable-dcgm-exporter
--tunnel-url wss://api.aisc.hpi.de:443
--tunnel-token-file ~/otela-tunnel-token
--tunnel-target otela-head.litellm.svc.cluster.local:43905
