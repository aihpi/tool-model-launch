# Qwen3-0.6B, one vLLM replica on one shared H100 (the reference job)
#   sml advanced --recipe qwen3-0.6b
# To serve another model: copy this file to ~/.sml/recipes/<name>.args and change
# --model, --served-model-name, --mem and --time.
--framework vllm
--gres gpu:h100:1
--cpus-per-task 8
--mem 48G
--time 02:00:00
--framework-args "--model Qwen/Qwen3-0.6B --served-model-name Qwen/Qwen3-0.6B --host 0.0.0.0"
