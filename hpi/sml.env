# Source before running sml on rx02:  source ~/tool-model-launch/hpi/sml.env
# Every value here is a public identifier; the tunnel token stays in ~/otela-tunnel-token.

# Slurm
export SML_PARTITION=aisc-batch
export SML_ACCOUNT=aisc-staff

# Our OpenTela head (k8s, litellm namespace). Bare peer ID: reached through the
# wstunnel the job opens (see the example script).
export SML_OPENTELA_BOOTSTRAP_ADDR=QmWBnedcUEawmdTQTXgyY6BAQFDMwiUDndmRqgGkRBY4Qr

# No launch telemetry sink at HPI.
export SML_TELEMETRY_ENDPOINT=

# `sml` health panel: probe through LiteLLM. LiteLLM exposes the served name as
# hosted_vllm/<user>/<vendor>/<model>; the "research API key" is a LiteLLM key.
export SML_HEALTH_CHECK_URL=https://api.aisc.hpi.de/v1/chat/completions
export SML_HEALTH_MODEL_PREFIX=hosted_vllm/
