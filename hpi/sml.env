# Source before running sml on rx02:  source ~/tool-model-launch/hpi/sml.env
# (the shared install's /sc/projects/sci-aisc/aisc-share/sml/env.sh sources this file).
# Every value here is a public identifier; the tunnel token stays in ~/otela-tunnel-token.

# Slurm. SML_LAUNCHER makes `sml init` skip the launcher question.
export SML_LAUNCHER=slurm
export SML_PARTITION=pot-hpi-aisc-batch
export SML_ACCOUNT=aisc-staff

# What users see: the TUI title and the `sml init` prompt for the health-check key.
export SML_SITE_NAME="HPI AISC"
export SML_HEALTH_KEY_NAME="LiteLLM API key"
export SML_HEALTH_KEY_HELP="Use a key for https://api.aisc.hpi.de that has the otela-test access group (ask the AISC team)."
# Stock pyxis (no --environment/EDF flag): translate the env toml into --container-* flags.
export SML_CONTAINER_SPEC=pyxis
# Pyxis unpacks ~30 GB of container rootfs per job into ~/.local/share/enroot (200 GB home
# quota). Every job points that directory here and prunes rootfs of finished jobs.
# Single quotes: $USER expands on the batch node, so this works for any user.
export SML_ENROOT_DATA_PATH='/sc/projects/sci-aisc/aisc-share/enroot-data/$USER'

# Hugging Face token for gated models: `sml init` asks for it once and writes this file
# (mode 600); jobs export it as HF_TOKEN without it entering scripts or logs. Single
# quotes: ~ means the job user's home on the node.
export SML_HF_TOKEN_FILE='~/.sml/hf-token'

# Our OpenTela head (k8s, litellm namespace). Bare peer ID: reached through the
# wstunnel the job opens (see the example script).
export SML_OPENTELA_BOOTSTRAP_ADDR=QmWBnedcUEawmdTQTXgyY6BAQFDMwiUDndmRqgGkRBY4Qr

# No launch telemetry sink at HPI.
export SML_TELEMETRY_ENDPOINT=

# `sml` health panel: probe through LiteLLM. LiteLLM exposes the served name as
# hosted_vllm/<user>/<vendor>/<model>; the "research API key" is a LiteLLM key.
export SML_HEALTH_CHECK_URL=https://api.aisc.hpi.de/v1/chat/completions
export SML_HEALTH_MODEL_PREFIX=hosted_vllm/

# Recipes: `sml advanced --recipe NAME` (list with `sml recipes`). The site file below
# is prepended to every `sml advanced`, so a recipe only holds what differs per model.
# Personal recipes go to ~/.sml/recipes, shared ones to the project share.
_sml_hpi_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export SML_ENVIRONMENT="$_sml_hpi_dir/envs/vllm_hpi.toml"
export SML_SITE_ARGS="$_sml_hpi_dir/recipes/_site.args"
export SML_RECIPE_PATH="$HOME/.sml/recipes:/sc/projects/sci-aisc/aisc-share/recipes:$_sml_hpi_dir/recipes"
unset _sml_hpi_dir
